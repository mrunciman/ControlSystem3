<CoordinateSystem> { Z-up }

<Group> Cylinder {
  <VertexPool> vpool {
    <Vertex> 0 { 1 0 -1 }
    <Vertex> 1 { 0 1 -1 }
    <Vertex> 2 { -1 0 -1 }
    <Vertex> 3 { 0 -1 -1 }
    <Vertex> 4 { 1 0 1 }
    <Vertex> 5 { 0 1 1 }
    <Vertex> 6 { -1 0 1 }
    <Vertex> 7 { 0 -1 1 }
  }

  # Bottom face (square approximation of circle)
  <Polygon> { <Normal> { 0 0 -1 } <VertexRef> { 0 1 2 3 <Ref> { vpool } } }

  # Top face
  <Polygon> { <Normal> { 0 0 1 } <VertexRef> { 4 5 6 7 <Ref> { vpool } } }

  # Side quads
  <Polygon> { <Normal> { 1 0 0 } <VertexRef> { 0 4 5 1 <Ref> { vpool } } }
  <Polygon> { <Normal> { 0 1 0 } <VertexRef> { 1 5 6 2 <Ref> { vpool } } }
  <Polygon> { <Normal> { -1 0 0 } <VertexRef> { 2 6 7 3 <Ref> { vpool } } }
  <Polygon> { <Normal> { 0 -1 0 } <VertexRef> { 3 7 4 0 <Ref> { vpool } } }
}
